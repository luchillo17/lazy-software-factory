# Cursor API key — local Runtime / Cursor SDK
CURSOR_API_KEY=
# GitHub personal access token — Issues + git push/PRs for local ADW runs
# Create a fine-grained token: https://github.com/settings/personal-access-tokens/new
# Repo: this factory only. Permissions (Read and write): Issues, Contents, Pull requests
# Metadata (Read) is automatic. Contents = commit/push; Pull requests = open/update PRs.
GH_TOKEN=
# Fresh Docker clones do not inherit host Git identity.
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=

# Optional defaults for `pnpm adw` / `pnpm adw:host` (prefer CLI flags; never commit real values)
# ADW_ISSUE=                 # Issue number, #N, or Issues URL (ready-for-agent)
# ADW_TICKET_ID=             # manual mode (mutually exclusive with ADW_ISSUE)
# ADW_PROMPT=
# ADW_REPO_URL=              # required for Docker (generic `adw` default)
# ADW_RUNNER_IMAGE=          # optional override of local runner image tag
# ADW_CWD=                   # Host only (`adw --sandbox host` / adw-host); rejected by Docker
# Local Cursor SDK model id (also accepted as CURSOR_MODEL). Default: grok-4.5
# ADW_MODEL=grok-4.5
