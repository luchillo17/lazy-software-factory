# Cursor API key — local Runtime / Cursor SDK
CURSOR_API_KEY=
# GitHub personal access token — Issues + git push/PRs for local ADW runs
# Create a fine-grained token: https://github.com/settings/personal-access-tokens/new
# Repo: this factory only. Permissions (Read and write): Issues, Contents, Pull requests
# Metadata (Read) is automatic. Contents = commit/push; Pull requests = open/update PRs.
GH_TOKEN=
