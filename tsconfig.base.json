{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["esnext"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ],
    "paths": {
      "@lazy-software-factory/runtime": ["./packages/runtime/src/index.ts"],
      "@lazy-software-factory/adw": ["./packages/adw/src/index.ts"],
      "@lazy-software-factory/git-host": ["./packages/git-host/src/index.ts"],
      "@lazy-software-factory/adw-worker": [
        "./packages/adw-worker/src/index.ts"
      ]
    }
  }
}
