{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/packages/adw",
    "rootDir": "src",
    "tsBuildInfoFile": "../../dist/out-tsc/packages/adw/tsconfig.lib.tsbuildinfo",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "vitest.config.ts",
    "vitest.config.mts"
  ],
  "references": [{ "path": "../runtime/tsconfig.lib.json" }]
}
