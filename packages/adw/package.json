{
  "name": "@lazy-software-factory/adw",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "nx": {
    "tags": [
      "type:lib",
      "scope:adw"
    ],
    "sourceRoot": "packages/adw/src",
    "projectType": "library",
    "targets": {
      "test-docker": {
        "cache": false,
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/adw",
          "command": "vitest run --config vitest.docker.config.mts"
        },
        "metadata": {
          "description": "Real Docker daemon integration (not cached; fails if Docker unavailable)"
        }
      }
    }
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.106",
    "@lazy-software-factory/adw-worker": "workspace:*",
    "@lazy-software-factory/git-host": "workspace:*",
    "@lazy-software-factory/runtime": "workspace:*",
    "effect": "4.0.0-beta.106"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.106",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  }
}
